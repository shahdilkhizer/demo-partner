        name="pendingApprovals"
        type="Integer"
        default="0"
        label="Pending Approvals"
      />
            <property
        name="leaveRequests"
        type="Integer"
        default="0"
        label="Leave Requests"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>